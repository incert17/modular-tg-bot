# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Environment Configuration
NODE_ENV=development
PORT=3000

# Deployment Mode (webhook or polling)
DEPLOYMENT_MODE=polling

# Webhook Configuration (for serverless deployments)
WEBHOOK_URL=https://your-domain.com/webhook

# Admin Configuration
ADMIN_USER_IDS=123456789,987654321

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=bot.log

# Weather Module Configuration (optional)
OPENWEATHER_API_KEY=your_openweather_api_key

# Database Configuration (optional, for future modules)
DATABASE_URL=your_database_url

# Security Configuration
WEBHOOK_SECRET=your_webhook_secret_key

# Rate Limiting (requests per minute per user)
RATE_LIMIT=30

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_METRICS=false

# Health Check Configuration
HEALTH_CHECK_TOKEN=your_health_check_token

